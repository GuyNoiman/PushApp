{
  "expo": {
    "name": "PushApp",
    "slug": "pushapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pushapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.guynoiman.pushapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "en",
          "he"
        ],
        "CFBundleDevelopmentRegion": "en"
      },
      "usesAppleSignIn": true,
      "supportsTablet": true
    },
    "android": {
      "package": "com.guynoiman.pushapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "POST_NOTIFICATIONS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "POST_NOTIFICATIONS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-asset",
      "expo-notifications",
      "expo-localization",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.872942140221-mjuroef83u4mhmeuo4310adt6gurk009"
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "PushApp saves your completion card to your photos, only when you tap Save.",
          "isAccessMediaLocationEnabled": false,
          "photosPermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "PushApp records a voice note only when you tap record, and it stays on this phone."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PushApp lets you attach a photo to something you are writing. It stays on this phone.",
          "cameraPermission": "PushApp lets you take a photo for something you are writing. It stays on this phone."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "private-dha",
          "project": "react-native",
          "url": "https://sentry.io/"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4505f207-aaec-48fc-95f7-039d72c1ec29"
      }
    },
    "owner": "guynoiman",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/4505f207-aaec-48fc-95f7-039d72c1ec29",
      "fallbackToCacheTimeout": 0
    },
    "locales": {
      "en": "./locales/en.json",
      "he": "./locales/he.json"
    }
  }
}
