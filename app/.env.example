# PushApp — environment template. Copy to `.env` and fill in real values.
# `.env` is gitignored; this `.env.example` is committed as documentation.
#
# Supabase (POC social/Allies pillar — Free tier). Client-safe values only.
# Get these from Supabase → Project Settings → API. NEVER put the secret (service_role) key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Single-user server sign-in (POC ONLY). When all three are set, the app signs in
# as this one known, server-verified user instead of an anonymous session (no signup
# UI). Leave them UNSET to keep the default anonymous behaviour.
#
# SECURITY: EXPO_PUBLIC_* values are inlined into the client bundle, so the password
# is extractable from a shipped build. This is acceptable ONLY for the founder's
# personal single-user POC on their own device. Production needs real auth with NO
# client-side password. The user must have a password set in Supabase Auth.
EXPO_PUBLIC_SINGLE_USER_EMAIL=you@example.com
EXPO_PUBLIC_SINGLE_USER_PASSWORD=your-supabase-user-password
EXPO_PUBLIC_SINGLE_USER_UID=00000000-0000-0000-0000-000000000000

# ── Google sign-in ────────────────────────────────────────────────────────────
# Two OAuth client ids from Google Cloud → APIs & Services → Credentials.
#  · WEB is the one Supabase's provider config uses, and the one the browser flow returns through.
#  · IOS is the native client, matched to the bundle id; it has no secret, which is normal.
# Both are PUBLIC BY DESIGN — they are inlined into the app bundle. The web client's SECRET is NOT
# here and must never be: it lives only in the Supabase dashboard (Authentication → Providers).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxx.apps.googleusercontent.com

# NOTE: the iOS client id also has a NATIVE side. Its reversed form
# (`com.googleusercontent.apps.<id>`) is the app's Google URL scheme and is committed in
# `app.json` under the google-signin plugin, because it is baked into the binary at BUILD time —
# an env var could not reach it, and a missing scheme breaks the sign-in redirect silently. That
# value is public by design, exactly like the client id itself. The client SECRET is neither here
# nor there: it lives only in the Supabase dashboard.
