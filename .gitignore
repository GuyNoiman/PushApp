# macOS
.DS_Store

# Claude Code — machine-local settings & personal permissions (do NOT share)
.claude/settings.local.json

# Obsidian local UI state (per-machine, noisy)
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# ── App build artifacts (never commit — keeps repo history small) ──
# Dependencies
node_modules/
# Expo / React Native
.expo/
.expo-shared/
dist/
web-build/
*.orig.*
# Native builds (if we ever eject / add EAS local builds)
app/ios/
app/android/
# Metro / bundler + logs
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
*.log
# Env / secrets (never in the client — Engineering Bible §12)
.env
.env.*
!.env.example

# Supabase CLI scratch state (project ref cache) — never useful in git.
app/supabase/.temp/

# Working folders for large binaries the repo does not need (2026-09-16).
# `output/` holds the founder Figma exports (26 MB of PNGs + a zip) and `tmp/` scratch PDFs.
# Every STRING from the approved design pack is transcribed into
# 04_Product/UX/Onboarding_Approved_Screens_Build_Spec_2026-09-15.md, so nothing is lost by
# keeping the images out of git history — where they would cost storage forever and could not be
# removed without rewriting it.
output/
tmp/
